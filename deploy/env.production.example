APP_NAME="Live Photo Wall"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://__DOMAIN__

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=__DB_NAME__
DB_USERNAME=__DB_USER__
DB_PASSWORD=__DB_PASS__

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb

# Reverb: browser terhubung lewat https://__DOMAIN__ (port 443),
# Nginx meneruskannya ke Reverb di 127.0.0.1:8080
REVERB_APP_ID=__REVERB_ID__
REVERB_APP_KEY=__REVERB_KEY__
REVERB_APP_SECRET=__REVERB_SECRET__
REVERB_HOST=__DOMAIN__
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# Isi dari dashboard Cloudinary (sama dengan .env di laptop)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Login /dashboard dan /moderasi
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=__DASHBOARD_PASS__
