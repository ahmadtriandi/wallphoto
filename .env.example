APP_NAME="Photo Gallery"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gallery_db
DB_USERNAME=root
DB_PASSWORD=

# ─── Queue (gunakan database agar mudah) ─────────────────
QUEUE_CONNECTION=database

# ─── Broadcasting ─────────────────────────────────────────
BROADCAST_CONNECTION=reverb

# ─── Laravel Reverb (WebSocket) ───────────────────────────
# Generate otomatis saat: php artisan reverb:install
REVERB_APP_ID=my-app-id
REVERB_APP_KEY=my-app-key
REVERB_APP_SECRET=my-app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── Cloudinary ───────────────────────────────────────────
# Daftar gratis di https://cloudinary.com
# Ambil dari Dashboard → API Keys
CLOUDINARY_URL=cloudinary://644432711465765:vLqtFVl8-aDoX74hdiOwcoUOCj4@dehq0igxy
CLOUDINARY_CLOUD_NAME=dehq0igxy
CLOUDINARY_API_KEY=644432711465765
CLOUDINARY_API_SECRET=vLqtFVl8-aDoX74hdiOwcoUOCj4
CLOUDINARY_UPLOAD_PRESET=ml_default
